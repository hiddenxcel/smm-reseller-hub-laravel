APP_NAME="Resellers Hub"
APP_ENV=local

# Sail container user/group. On Windows these have no host equivalent, so any
# non-zero pair works; without them the image build fails on `groupadd -g ''`.
WWWUSER=1000
WWWGROUP=1000

APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API. Platform-level: Meta signs every inbound webhook with the
# app secret regardless of whose number the message arrived on.
META_APP_SECRET=
META_VERIFY_TOKEN=

# The platform's own merchant accounts — used when a RESELLER pays us for a
# subscription. Not a reseller's own keys, which they store per-tenant in
# tenant_payment_gateways. A gateway listed in config/billing.php but left
# blank here is skipped at checkout rather than offered and then failing.
BILLING_SNIPPE_API_KEY=
BILLING_SNIPPE_WEBHOOK_SECRET=
# Snippe settles in TZS while plans are priced in USD, so this rate converts
# the charge for that one gateway.
BILLING_SNIPPE_USD_TO_TZS=2600

BILLING_NOWPAYMENTS_API_KEY=
BILLING_NOWPAYMENTS_IPN_SECRET=
BILLING_NOWPAYMENTS_PAY_CURRENCY=usdttrc20

# Cryptomus and Heleket share an API: each needs a Merchant UUID and a
# Payment API key from its own dashboard.
BILLING_CRYPTOMUS_API_KEY=
BILLING_CRYPTOMUS_MERCHANT_ID=

BILLING_HELEKET_API_KEY=
BILLING_HELEKET_MERCHANT_ID=

# Binance Merchant → Developers, NOT the Spot API keys used for trading —
# those cannot open a Binance Pay order. The secret signs the outgoing order
# request as well as verifying the webhook, so both are required before the
# gateway is offered at checkout.
BILLING_BINANCE_API_KEY=
BILLING_BINANCE_API_SECRET=

# The first super-admin, created by SuperadminSeeder as an `owner`. Credentials
# come from here rather than from source, and the seeder skips silently when
# they are blank — so a deploy that forgets them creates nobody rather than
# creating a known login.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
