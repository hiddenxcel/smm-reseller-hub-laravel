# Production .env for smmresellershub.com
#
# Copy this to the server as ~/smm-reseller-hub/shared/.env and fill in every
# CHANGE_ME. It is not in the release tarball and it survives deploys — the
# deploy symlinks each release at this one file.
#
#   chmod 600 ~/smm-reseller-hub/shared/.env
#
# Never commit the filled-in version.

APP_NAME="Resellers Hub"
APP_ENV=production

# php artisan key:generate --show   (run once, paste the result)
APP_KEY=CHANGE_ME

# Off in production: on, it prints stack traces — including database
# credentials — to anyone who triggers an error.
APP_DEBUG=false

APP_URL=https://smmresellershub.com

# Render the React pages to HTML in Node before serving them, so a crawler
# that does not run JavaScript still gets the words. Without this the
# marketing pages reach Google, Bing and the WhatsApp link preview as an
# empty div. Needs the smmhub-ssr service running — see deploy/install.sh.
INERTIA_SSR_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# debug fills the disk on a busy box; warning keeps what matters.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smmhub
DB_USERNAME=smmhub
# The one server-setup.sh printed (also in shared/.db_password)
DB_PASSWORD=CHANGE_ME

# HestiaCP may use Redis too, so this app keeps to its own databases.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=2

CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot so a session works on both the apex and www.
SESSION_DOMAIN=.smmresellershub.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Mail ----------------------------------------------------------------
# Resend rather than a mail server on this box: a fresh VPS IP has no sending
# reputation, so password-reset mail from it lands in spam. Sign up at
# resend.com, verify smmresellershub.com, then paste the API key below.
#
# Until this is set, password resets and notifications will not arrive.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@smmresellershub.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the contact form delivers. Not the From address above: that is a
# noreply with no mailbox behind it, so pointing the form there loses every
# message a visitor sends.
MAIL_CONTACT_ADDRESS="info@smmresellershub.com"

VITE_APP_NAME="${APP_NAME}"

# ---- WhatsApp (Meta Cloud API) -------------------------------------------
# From the Meta app dashboard. The verify token is yours to invent — it just
# has to match what you type into Meta's webhook setup.
META_APP_SECRET=CHANGE_ME
META_VERIFY_TOKEN=CHANGE_ME

# The number a visitor messages to try the bot before signing up, in full
# international form. The "Try the bot" button only renders when this is set,
# so leaving it blank quietly removes the one place a stranger can see the
# product working — which is most of the argument for buying it.
DEMO_WHATSAPP_NUMBER=

# ---- Billing gateways ----------------------------------------------------
# Leave blank until you have each account; the app treats a blank gateway as
# not configured rather than broken.
BILLING_SNIPPE_API_KEY=
BILLING_SNIPPE_WEBHOOK_SECRET=
BILLING_SNIPPE_USD_TO_TZS=2600
BILLING_NOWPAYMENTS_API_KEY=
BILLING_NOWPAYMENTS_IPN_SECRET=
BILLING_NOWPAYMENTS_PAY_CURRENCY=usdttrc20
BILLING_CRYPTOMUS_API_KEY=
BILLING_CRYPTOMUS_MERCHANT_ID=
BILLING_HELEKET_API_KEY=
BILLING_HELEKET_MERCHANT_ID=
# Binance Merchant → Developers, not Spot API keys. Both are required: the
# secret signs the order request, not only the webhook.
BILLING_BINANCE_API_KEY=
BILLING_BINANCE_API_SECRET=

# ---- Super admin ---------------------------------------------------------
# The /hx-control login. Use a long password — this account can see every
# tenant on the platform.
SUPERADMIN_USERNAME=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_NAME="Super Admin"
